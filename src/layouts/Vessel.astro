---
/**
 * Section pages (projects, research, coursework, about, and every entry).
 * No 3D here: these pages are for reading, so they are plain HTML and CSS,
 * dressed in the section's glaze, with gold seams between the pieces.
 */
import Base from './Base.astro';
import IndexMenu from '../components/IndexMenu.astro';
import IndexButton from '../components/IndexButton.astro';
import GoldDefs from '../components/kintsugi/GoldDefs.astro';
import { site } from '../data/site';
import '../styles/kintsugi.css';

interface Props {
  title: string;
  description?: string;
  glaze: 'celadon' | 'slate' | 'tenmoku' | 'shino';
  /** the section this page belongs to, shown beside the wordmark */
  section?: { label: string; href: string };
}
const { title, description, glaze, section } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<Base title={`${title} — ${site.wordmark}`} description={description} glaze={glaze}>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="vessel" data-glaze={glaze}>
    <GoldDefs />
    <header class="masthead">
      <span class="masthead-trail">
        <a class="wordmark" href={`${base}/`}>{site.wordmark}</a>
        {section && <a class="trail-section" href={`${base}${section.href}`}>{section.label}</a>}
      </span>
      <div class="masthead-tools">
        <IndexButton />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="page-foot">
      {site.wordmark}, {year}. Every piece here was broken, repaired, and kept.
    </footer>
  </div>
  <IndexMenu />

  <script>
    import '../scripts/page';
  </script>
</Base>
