---
import '../styles/global.css';
import { site } from '../data/site';
// the two faces visible in the first frame; fetched early so text never reflows under the reveal
import newsreaderUrl from '../assets/fonts/newsreader-var.woff2?url';
import hankenUrl from '../assets/fonts/hanken-grotesk-var.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** section pages: which tea-coloured ground the page sits on */
  ground?: 'tsuchi' | 'fukamidori' | 'uguisu' | 'rikyu';
}
const { title = site.title, description = site.description, ground } = Astro.props;
const groundColour = { tsuchi: '#3a2d24', fukamidori: '#252b23', uguisu: '#34362a', rikyu: '#38342c' };
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-motion="on" data-theme="field" data-ground={ground}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={ground ? groundColour[ground] : '#161812'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={hankenUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Set motion preference before first paint so nothing animates that shouldn't.
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('archive:motion'); } catch (e) {}
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var on = stored ? stored === 'on' : !reduce;
        document.documentElement.dataset.motion = on ? 'on' : 'off';
        document.documentElement.dataset.js = 'on';
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
