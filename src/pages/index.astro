---
import Base from '../layouts/Base.astro';
import RingsFallback from '../components/RingsFallback.astro';
import IndexMenu from '../components/IndexMenu.astro';
import IndexButton from '../components/IndexButton.astro';
import Experience from '../experience/Experience';
import { site, intro, acts } from '../data/site';
import { getProjects, getResearch, getSemesters, url } from '../lib/content';
import { formatRange } from '../lib/dates';

// what each section panel lists: a short, current selection
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const semesters = await getSemesters();
const courses = semesters.flatMap((s) => s.courses);
const lists = {
  projects: (featured.length ? featured : projects).slice(0, 4).map((p) => ({
    href: url(`/projects/${p.id}/`),
    title: p.data.title,
    meta: formatRange(p.data.start, p.data.end),
  })),
  research: (await getResearch()).slice(0, 4).map((r) => ({
    href: url(`/research/${r.id}/`),
    title: r.data.title,
    meta: `${r.data.lab}, ${formatRange(r.data.start, r.data.end)}`,
  })),
  courses: courses.slice(0, 5).map((c) => ({
    href: url(`/coursework/${c.id}/`),
    title: c.data.title,
    meta: [c.data.code, c.data.term && c.data.year ? `${c.data.term} ${c.data.year}` : undefined].filter(Boolean).join(', '),
  })),
};
const totals = { projects: projects.length, research: lists.research.length, courses: courses.length };

const stations = [
  { href: '#top', numeral: 'I', name: 'Introduction' },
  { href: '#coursework', numeral: 'II', name: 'Coursework' },
  { href: '#projects', numeral: 'III', name: 'Projects' },
  { href: '#research', numeral: 'IV', name: 'Research' },
  { href: '#about', numeral: 'V', name: 'Archive' },
];
const sides = ['right', 'left', 'right', 'left'];
const year = new Date().getFullYear();
---

<Base>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="loader" id="loader" aria-hidden="true">
    <figure>
      <svg viewBox="-40 -40 80 80">
        {[8, 15, 22, 29, 36].map((r) => <circle r={r} pathLength="1" />)}
      </svg>
      <figcaption>
        Preparing the specimen<br /><span id="loader-count">0</span> rings counted
      </figcaption>
    </figure>
  </div>
  <noscript><style>.loader { display: none; }</style></noscript>

  <div class="world" aria-hidden="true">
    <RingsFallback />
    <Experience client:only="react" />
  </div>
  <div class="grain" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>

  <div class="annotation" aria-hidden="true">
    <svg><line id="ann-line" x1="0" y1="0" x2="0" y2="0"></line><circle id="ann-dot" r="4"></circle></svg>
    <span class="annotation-label" id="ann-label">{intro.originLabel}</span>
  </div>

  <header class="masthead">
    <a class="wordmark" href="#top">{site.wordmark}</a>
    <div class="masthead-tools">
      <button class="tool" id="motion-toggle" type="button" aria-pressed="true">Motion on</button>
      <IndexButton />
    </div>
  </header>

  <nav class="gauge" aria-label="Sections">
    <div class="gauge-track"></div>
    <div class="gauge-marker"></div>
    <ol>
      {
        stations.map((s, i) => (
          <li style={`top:${(i / (stations.length - 1)) * 100}%`}>
            <a href={s.href} data-station={i}>
              {s.numeral}
              <span class="gauge-name">{s.name}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <dl class="readout" aria-hidden="true">
    <dt>x</dt><dd id="ro-x">0.000</dd>
    <dt>z</dt><dd id="ro-z">0.000</dd>
    <dt>ring</dt><dd id="ro-ring">0</dd>
  </dl>

  <main id="main">
    <section id="top" class="act hero" data-act="0" aria-labelledby="hero-title">
      <p class="plate" data-reveal>Plate I. Specimen, oblique view</p>
      <h1 id="hero-title">
        {intro.heading.map((line) => <span class="line"><span data-line>{line}</span></span>)}
      </h1>
      <div class="hero-meta" data-reveal>
        <p class="byline">{site.name}<span>{site.role}</span></p>
        <p class="hero-body">{intro.body}</p>
      </div>
      <a class="scroll-cue" href="#coursework" data-reveal><i aria-hidden="true"></i>Scroll to descend</a>
    </section>

    {
      acts.map((act, i) => (
        <section id={act.id} class="act" data-act={i + 1} data-side={sides[i]} aria-labelledby={`${act.id}-title`}>
          <div class="act-panel">
            <p class="plate">{act.plate}</p>
            <h2 id={`${act.id}-title`}>{act.heading}</h2>
            {act.body.map((p) => <p>{p}</p>)}
            {act.entries && (
              <ol class="act-entries" role="list">
                {lists[act.entries].map((e) => (
                  <li>
                    <a href={e.href}>
                      <span class="t">{e.title}</span>
                      <span class="m">{e.meta}</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
            {act.more && (
              <a class="act-more" href={url(act.more.href)}>
                {act.more.label}
                {act.entries && <span class="m"> ({totals[act.entries]})</span>}
              </a>
            )}
            {act.placeholder && (
              <p class="placeholder">
                <b>Placeholder.</b> {act.placeholder}
              </p>
            )}
            {act.subsections && (
              <div class="subsections">
                {act.subsections.map((sub) => (
                  <div id={sub.id}>
                    <h3>{sub.heading}</h3>
                    {sub.body.map((p) => <p>{p}</p>)}
                    {sub.links && (
                      <ul class="links">
                        {sub.links.map((l) =>
                          l.disabled ? (
                            <li class="is-disabled">
                              {l.label}
                              {l.note && <small>Placeholder: {l.note}</small>}
                            </li>
                          ) : (
                            <li>
                              <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
                                {l.label}
                              </a>
                            </li>
                          ),
                        )}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      ))
    }
  </main>

  <footer class="colophon">
    <span>{site.wordmark}, {year}. The archive is still growing.</span>
    <span>Set in Newsreader, Hanken Grotesk and IBM Plex Mono.</span>
  </footer>

  <IndexMenu />

  <script>
    import '../scripts/interface';
  </script>
</Base>
