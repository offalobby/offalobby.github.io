---
/** The site index (menu): a printed contents page, shared by every page. */
import { nav } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname;
const href = (h: string) => (h.startsWith('/') ? `${base}${h}` : h);
---

<div class="index" id="index" role="dialog" aria-modal="true" aria-labelledby="index-title" hidden>
  <div class="index-head">
    <span class="wordmark" id="index-title">Index</span>
    <button class="tool" id="index-close" type="button">Close</button>
  </div>
  <nav aria-label="Site">
    <ol>
      {
        nav.map((item) => {
          const path = item.href.split('#')[0];
          const here = !item.href.includes('#') && path === current;
          return (
            <li>
              <a href={href(item.href)} data-index-link aria-current={here ? 'page' : undefined}>
                <span class="label">{item.label}</span>
                <span class="hint">{item.hint}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </nav>
  <p class="index-foot">Press Escape to close.</p>
</div>
