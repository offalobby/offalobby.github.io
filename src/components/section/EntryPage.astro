---
/**
 * One template for every detail page: title, a short lede, a faint gold
 * crack, the facts, then the write-up set for reading. Previous / next close
 * the page.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Crack from './Crack.astro';

export interface Fact {
  label: string;
  value?: string;
  list?: string[];
  links?: { label: string; href: string }[];
}
interface Neighbour {
  href: string;
  title: string;
}
interface Props {
  seed: string;
  section: { label: string; href: string };
  title: string;
  lede?: string;
  facts: Fact[];
  cover?: ImageMetadata;
  coverAlt?: string;
  prev?: Neighbour;
  next?: Neighbour;
  /** shown when the body has no text yet */
  emptyNote?: string;
  hasBody: boolean;
}
const { seed, section, title, lede, facts, cover, coverAlt, prev, next, emptyNote, hasBody } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article>
  <header class="entry-head">
    <h1>{title}</h1>
    <Crack class="crack-rule" seed={`${seed}:crack`} />
    {lede && <p class="lede">{lede}</p>}
    <dl class="facts">
      {
        facts
          .filter((f) => f.value || f.list?.length || f.links?.length)
          .map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>
                {f.value}
                {f.list && f.list.length > 0 && (
                  <ul class="list">
                    {f.list.map((x) => (
                      <li>{x}</li>
                    ))}
                  </ul>
                )}
                {f.links && f.links.length > 0 && (
                  <ul class="list">
                    {f.links.map((l) => (
                      <li>
                        <a href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined}>
                          {l.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </dd>
            </div>
          ))
      }
    </dl>
  </header>

  {
    cover && (
      <figure class="entry-cover">
        <Image src={cover} alt={coverAlt ?? ''} widths={[640, 1024, 1600]} sizes="(max-width: 900px) 100vw, 50rem" loading="eager" />
      </figure>
    )
  }

  <div class="prose">
    <slot />
    {
      !hasBody && emptyNote && (
        <p class="placeholder-note">
          <b>Placeholder.</b> {emptyNote}
        </p>
      )
    }
  </div>

  {
    (prev || next) && (
      <nav class="entry-nav" aria-label={`More ${section.label.toLowerCase()}`}>
        {prev && (
          <a class="prev" href={prev.href}>
            <span>Previous</span>
            <strong>{prev.title}</strong>
          </a>
        )}
        {next && (
          <a class="next" href={next.href}>
            <span>Next</span>
            <strong>{next.title}</strong>
          </a>
        )}
      </nav>
    )
  }
  <a class="back" href={`${base}${section.href}`}>All {section.label.toLowerCase()}</a>
</article>
