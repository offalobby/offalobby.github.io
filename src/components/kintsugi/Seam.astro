---
/**
 * A gold repair line. Horizontal seams stretch to the width of their parent;
 * vertical seams to its height. Geometry is fixed by `seed`.
 */
import { seam } from '../../lib/kintsugi';

interface Props {
  seed: string;
  orientation?: 'h' | 'v';
  /** thickness of the band the line wanders in, in px */
  span?: number;
  weight?: number;
  branches?: number;
  class?: string;
}
const { seed, orientation = 'h', span = 32, weight = 3.2, branches = 2, class: cls } = Astro.props;
const s = seam(seed, { orientation, span, weight, branches, length: 1000 });
const size = orientation === 'h' ? { height: span } : { width: span };
---

<svg
  class:list={['seam', `seam-${orientation}`, cls]}
  viewBox={s.viewBox}
  preserveAspectRatio="none"
  {...size}
  aria-hidden="true"
  focusable="false"
>
  {s.paths.map((d) => <path d={d} fill="url(#kg)" />)}
</svg>
