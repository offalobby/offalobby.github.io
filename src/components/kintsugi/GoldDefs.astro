---
/** Gold used by every seam on the page; referenced as fill="url(#kg)". */
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="kg" x1="0" y1="0" x2="1" y2="0.6">
      <stop offset="0" stop-color="#6b4a1b" />
      <stop offset="0.18" stop-color="#b5883a" />
      <stop offset="0.34" stop-color="#e8ca7c" />
      <stop offset="0.43" stop-color="#f8e8b4" />
      <stop offset="0.56" stop-color="#c39441" />
      <stop offset="0.74" stop-color="#e8ca7c" />
      <stop offset="1" stop-color="#8a6326" />
    </linearGradient>
  </defs>
</svg>
