---
/** A short gold crack running into a shard from one of its edges. */
import { seam, random } from '../../lib/kintsugi';

interface Props {
  seed: string;
}
const { seed } = Astro.props;
const r = random(`${seed}:crack`);
// only some shards are cracked, and each crack starts from a different edge
const show = r() < 0.55;
const fromTop = r() < 0.5;
const left = Math.round(10 + r() * 60);
// fixed pixel width keeps the gold hairline thin at any shard size
const width = Math.round(22 + r() * 18);
const s = seam(`${seed}:c`, { orientation: 'v', span: width, weight: 1.5, branches: 1, length: 1000 });
const style = `left:${left}%;${fromTop ? 'top' : 'bottom'}:-4px;width:${width}px;height:${Math.round(30 + r() * 30)}%;${fromTop ? '' : 'transform:scaleY(-1);'}`;
---

{
  show && (
    <svg class="crack" viewBox={s.viewBox} preserveAspectRatio="none" style={style} aria-hidden="true" focusable="false">
      <path d={s.paths[0]} fill="url(#kg)" opacity="0.9" />
    </svg>
  )
}
